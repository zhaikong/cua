{
  "name": "cua-test-harness-electron",
  "version": "1.0.0",
  "description": "cua-driver Electron test harness \u2014 loads the same shared/web/index.html as CuaTestHarness.WebView",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node init && electron .",
    "start:linux": "node init && electron . --no-sandbox --disable-gpu --force-renderer-accessibility",
    "start:macos": "node init && electron . --force-renderer-accessibility",
    "build": "node init && electron-builder --win portable --x64",
    "build:linux": "node init && electron-builder --linux dir --x64",
    "build:macos": "node init && electron-builder --mac dir --universal"
  },
  "devDependencies": {
    "electron": "39.8.5",
    "electron-builder": "25.0.5"
  },
  "build": {
    "appId": "com.trycua.harness.electron",
    "productName": "CuaTestHarness.Electron",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "portable": {
      "artifactName": "CuaTestHarness.Electron.exe"
    }
  }
}
